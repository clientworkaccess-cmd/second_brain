# Copy to .env.local for development, or to /opt/brain-app/.env on the VPS.
# Never commit the filled-in version.

# ---------------------------------------------------------------------------
# Where the wiki lives. The app writes here; the agent writes inside it.
# Locally this is a throwaway folder. Never a copy of real documents.
#   VPS: /var/brain-data
# ---------------------------------------------------------------------------
WIKI_ROOT=./.wiki-dev

# ---------------------------------------------------------------------------
# The agent: Claude Code, signed in with the team's subscription.
#
#   local :  node scripts/fake-claude.mjs   (no login, no usage, no real documents)
#   VPS   :  the claude binary installed for the user the service runs as
#
# There is no API key setting, on purpose. If ANTHROPIC_API_KEY were in the
# agent's environment the binary would bill that key instead of using the
# subscription, so the app never passes one on.
# ---------------------------------------------------------------------------
CLAUDE_CMD=node
CLAUDE_ARGS=scripts/fake-claude.mjs

# On the VPS instead:
# CLAUDE_CMD=/home/brain/.local/bin/claude
# CLAUDE_ARGS=
# CLAUDE_CONFIG_DIR=/var/lib/brain-app/claude

# Model alias or id (sonnet, opus, ...). Empty uses Claude Code's default.
CLAUDE_MODEL=

# ---------------------------------------------------------------------------
# Sign-in. One shared login. All three lines come from:
#
#   npm run hash-password -- you@example.com
#
# Sign-in stays closed until all three are set; there is no built-in login.
# Changing SESSION_SECRET signs everyone out.
# ---------------------------------------------------------------------------
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# A second factor, optional but meant for the server:
#
#   npm run totp-secret
#
# prints a secret and the setup key for an authenticator app. Set, the sign-in
# asks for the six-digit code as well as the password. Empty, it does not.
AUTH_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Ceilings, in milliseconds. A run that exceeds one is stopped and the job is
# marked failed. Planning 10 minutes, filing 15, one chat answer 5.
# ---------------------------------------------------------------------------
PLAN_TIMEOUT_MS=600000
INGEST_TIMEOUT_MS=900000
CHAT_TIMEOUT_MS=300000
