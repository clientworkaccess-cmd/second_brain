# Copy to .env.local for development, or /opt/dashboard/.env on the VPS.
# Never commit the filled-in version.

# ---------------------------------------------------------------------------
# Where the wiki lives. The app writes here; the agent writes inside it.
# Locally this should be a throwaway folder — never a copy of client data.
# ---------------------------------------------------------------------------
WIKI_ROOT=./.wiki-dev

# ---------------------------------------------------------------------------
# The agent. This is the only difference between a dev machine and the VPS.
#
#   local :  node scripts/fake-hermes.mjs   (no API key, no spend, no real docs)
#   VPS   :  /usr/local/bin/hermes
# ---------------------------------------------------------------------------
HERMES_CMD=node
HERMES_ARGS=scripts/fake-hermes.mjs

# On the VPS instead:
# HERMES_CMD=/usr/local/bin/hermes
# HERMES_ARGS=

# ---------------------------------------------------------------------------
# The model key. This is the ONLY secret the agent's environment is given —
# it runs unattended with shell access over documents we did not write, so
# anything else in its env is something an injected PDF could exfiltrate.
# ---------------------------------------------------------------------------
HERMES_API_KEY=

# Hard ceiling on one ingest before the job is marked failed. 15 minutes.
INGEST_TIMEOUT_MS=900000
