# /etc/systemd/system/dashboard.service
#
# systemctl daemon-reload && systemctl enable --now dashboard

[Unit]
Description=Knowledge Graph dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dashboard
EnvironmentFile=/opt/dashboard/.env

# ONE process. The per-cluster busy lock is in-process, so a second instance or
# any clustering silently breaks write serialisation — two ingests would both
# rewrite index.md and one would lose. Do not add a process manager that forks.
ExecStart=/usr/bin/node .next/standalone/server.js

# Bind loopback only. Traefik is the only thing that should reach this, and
# `hermes dashboard` is never exposed at all — SSH tunnel for ops.
Environment=HOSTNAME=127.0.0.1
# 3002, not 3000 — another developer's app owns 3000 on this box. Confirmed
# 2026-08-24. Changing this means changing deploy.sh's health check and the
# Traefik service URL to match.
Environment=PORT=3002
Environment=NODE_ENV=production

# systemd gives a service no HOME by default. Hermes reads its own config and
# credentials from ${HERMES_HOME:-~/.hermes}, so without this the spawned agent
# cannot find them — and the failure reads as a missing API key rather than a
# missing HOME, which is a long way to walk for a one-line fix.
Environment=HOME=/root

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
