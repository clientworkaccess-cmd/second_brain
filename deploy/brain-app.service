[Unit]
Description=Second Brain (brain-app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Running directly as root
User=root
Group=root

WorkingDirectory=/opt/brain-app
EnvironmentFile=/opt/brain-app/.env

# ONE process. Do not add a process manager that forks.
ExecStart=/usr/bin/node .next/standalone/server.js

# Networking & Environment
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3003
Environment=NODE_ENV=production
Environment=APP_DIR=/opt/brain-app

# Claude Isolated Environment
Environment=HOME=/var/lib/brain-app/home
Environment=CLAUDE_CONFIG_DIR=/var/lib/brain-app/claude
Environment=DISABLE_AUTOUPDATER=1

# ---------------------------------------------------------------------------
# Isolation & Hardening
# ---------------------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/brain-data /var/lib/brain-app /opt/brain-app/.next/cache
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0027

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target